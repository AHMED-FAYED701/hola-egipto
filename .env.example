# Environment keys (kit/docs/03-CONTRACTS.md §2). Names only: real values live in .env.local (local),
# .env.hostinger.local (scripts run from WSL against Hostinger) and hPanel (the running app).
# Never name a file .env.production(.local): next build/start would load it.

# MySQL connection string: mysql://user:pass@host:3306/db
DATABASE_URL=
# Signing key for sessions, preview cookie, tokens and refs (openssl rand -hex 32)
APP_SECRET=
# Absolute base URL, no trailing slash, read at runtime (e.g. https://hola-egipto.com)
SITE_URL=
# 1 = coming-soon page for visitors
HOLA_COMING_SOON=
# Preview bypass key, also the admin setup key (openssl rand -hex 16)
HOLA_PREVIEW_KEY=
# 1 = dev mail redirect to ADMIN_EMAIL, test headers allowed, forms accepted without Turnstile
HOLA_DEV_MODE=
# 1 = apply pending migrations when the server starts (0 locally, 1 on Hostinger)
HOLA_AUTO_MIGRATE=
# The only mail recipient while HOLA_DEV_MODE=1
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
N8N_WEBHOOK_URL=
HOLA_WEBHOOK_SECRET=
# Mail log path (default kit/logs/mail.log)
HOLA_MAIL_LOG=
# Admin image uploads: absolute folder OUTSIDE the deployed app (survives redeploys).
# Hostinger: /home/<user>/domains/<domain>/hola-uploads. Empty = auto (next to hbuilds/ on Hostinger, ./.uploads locally).
HOLA_UPLOAD_DIR=
