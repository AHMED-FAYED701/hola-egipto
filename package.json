{
  "name": "hola-egipto",
  "version": "1.0.0",
  "description": "Hola Egipto website (Next.js + Payload CMS)",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/hola/run.mjs migrate",
    "hola:schema": "node scripts/hola/run.mjs schema",
    "hola:health": "node scripts/hola/run.mjs health",
    "hola:seed": "payload run scripts/hola/seed.ts --",
    "hola:placeholders": "payload run scripts/hola/placeholders.ts --",
    "hola:samples": "payload run scripts/hola/samples.ts --",
    "hola:urls": "payload run scripts/hola/urls.ts --",
    "hola:token": "payload run scripts/hola/token.ts --",
    "hola:preview-url": "payload run scripts/hola/preview-url.ts --",
    "hola:test-session": "payload run scripts/hola/test-session.ts --",
    "hola:settings": "payload run scripts/hola/settings.ts --",
    "hola:inquiries": "payload run scripts/hola/inquiries.ts --",
    "hola:retention": "payload run scripts/hola/retention.ts --",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "bcryptjs": "^3.0.3",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.8.1",
    "jose": "6.2.12",
    "lucide-react": "1.59.0",
    "marked": "^18.1.1",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "^7.0.13",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.4.2",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "private": true
}
