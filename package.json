{
  "name": "hola-egipto",
  "version": "1.0.0",
  "description": "Hola Egipto website (Next.js + MySQL, custom admin)",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/hola/run.mjs migrate",
    "db:generate": "drizzle-kit generate",
    "hola:health": "node scripts/hola/run.mjs health",
    "hola:schema": "node scripts/hola/run.mjs schema",
    "hola:seed": "node scripts/hola/run.mjs seed",
    "hola:placeholders": "node scripts/hola/run.mjs placeholders",
    "hola:samples": "node scripts/hola/run.mjs samples",
    "hola:urls": "node scripts/hola/run.mjs urls",
    "hola:token": "node scripts/hola/run.mjs token",
    "hola:preview-url": "node scripts/hola/run.mjs preview-url",
    "hola:setup-url": "node scripts/hola/run.mjs setup-url",
    "hola:test-session": "node scripts/hola/run.mjs test-session",
    "hola:settings": "node scripts/hola/run.mjs settings",
    "hola:inquiries": "node scripts/hola/run.mjs inquiries",
    "hola:retention": "node scripts/hola/run.mjs retention",
    "hola:deploy-check": "node scripts/hola/run.mjs deploy-check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cross-env": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.12",
    "lucide-react": "1.59.0",
    "marked": "^18.1.1",
    "mysql2": "^3.24.6",
    "nanoid": "^3.3.20",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "^7.0.13",
    "picocolors": "^1.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.4.2",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "private": true,
  "packageManager": "pnpm@12.14.0"
}
